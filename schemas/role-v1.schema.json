{
  "$id": "https://hubtech.dev/hubicg/schemas/role-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "items": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "type": "string"},
      "maxItems": 64,
      "type": "array",
      "uniqueItems": true
    },
    "conflictsWith": {
      "items": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "type": "string"},
      "maxItems": 64,
      "type": "array",
      "uniqueItems": true
    },
    "id": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "type": "string"},
    "instructions": {"maxLength": 20000, "minLength": 1, "type": "string"},
    "locale": {"pattern": "^(?:und|[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*)$", "type": "string"},
    "name": {"maxLength": 120, "minLength": 1, "type": "string"},
    "schemaVersion": {"const": "1.0"},
    "tags": {
      "items": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "type": "string"},
      "maxItems": 64,
      "type": "array",
      "uniqueItems": true
    },
    "version": {"pattern": "^[0-9]+(?:\\.[0-9]+){0,2}$", "type": "string"}
  },
  "required": ["schemaVersion", "id", "name", "instructions"],
  "title": "HubICG role schema v1",
  "type": "object"
}
