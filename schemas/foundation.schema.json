{
  "$id": "https://hubtech.dev/hubicg/schemas/foundation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "guardrails": {"items": {"maxLength": 2000, "minLength": 1, "type": "string"}, "type": "array"},
    "id": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "type": "string"},
    "lawsAndModels": {"items": {"maxLength": 2000, "minLength": 1, "type": "string"}, "type": "array"},
    "locale": {"pattern": "^(?:und|[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*)$", "type": "string"},
    "name": {"maxLength": 120, "minLength": 1, "type": "string"},
    "practices": {"items": {"maxLength": 2000, "minLength": 1, "type": "string"}, "minItems": 1, "type": "array"},
    "principles": {"items": {"maxLength": 2000, "minLength": 1, "type": "string"}, "minItems": 1, "type": "array"},
    "references": {"items": {"maxLength": 2000, "minLength": 1, "type": "string"}, "type": "array"},
    "schemaVersion": {"const": "2.0"},
    "summary": {"maxLength": 2000, "minLength": 1, "type": "string"},
    "theories": {"items": {"maxLength": 2000, "minLength": 1, "type": "string"}, "type": "array"},
    "version": {"pattern": "^[0-9]+(?:\\.[0-9]+){0,2}$", "type": "string"}
  },
  "required": ["schemaVersion", "id", "name", "version", "summary", "principles", "practices"],
  "title": "HubICG shared foundation schema",
  "type": "object"
}
