{
  "$id": "https://hubtech.dev/hubicg/schemas/role-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "area": {"maxLength": 2000, "minLength": 1, "pattern": "\\S", "type": "string"},
    "blocks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "body": {"maxLength": 20000, "minLength": 1, "pattern": "\\S", "type": "string"},
          "heading": {"maxLength": 200, "minLength": 1, "pattern": "\\S", "type": "string"}
        },
        "required": ["heading", "body"],
        "type": "object"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array"
    },
    "capabilities": {
      "items": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "type": "string"},
      "maxItems": 64,
      "type": "array",
      "uniqueItems": true
    },
    "conflictsWith": {
      "items": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "type": "string"},
      "maxItems": 64,
      "type": "array",
      "uniqueItems": true
    },
    "extends": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "type": "string"},
    "foundations": {
      "items": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "type": "string"},
      "maxItems": 64,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "id": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "type": "string"},
    "lead": {"maxLength": 2000, "minLength": 1, "pattern": "\\S", "type": "string"},
    "locale": {"pattern": "^(?:und|[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*)$", "type": "string"},
    "name": {"maxLength": 120, "minLength": 1, "pattern": "\\S", "type": "string"},
    "proficiency": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "level": {"enum": ["P0", "P1", "P2", "P3", "P4"]},
          "scope": {"maxLength": 2000, "minLength": 1, "pattern": "\\S", "type": "string"},
          "tool": {"maxLength": 200, "minLength": 1, "pattern": "\\S", "type": "string"}
        },
        "required": ["tool", "level", "scope"],
        "type": "object"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array"
    },
    "roleVersion": {"pattern": "^[0-9]+(?:\\.[0-9]+){0,2}$", "type": "string"},
    "schemaVersion": {"const": "2.0"},
    "section": {"maxLength": 2000, "minLength": 1, "pattern": "\\S", "type": "string"},
    "seniority": {"maxLength": 2000, "minLength": 1, "pattern": "\\S", "type": "string"},
    "specializations": {
      "items": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "type": "string"},
      "maxItems": 64,
      "type": "array",
      "uniqueItems": true
    },
    "tags": {
      "items": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "type": "string"},
      "maxItems": 64,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": ["schemaVersion", "id", "name", "roleVersion", "foundations", "proficiency", "blocks"],
  "title": "HubICG role schema v2 (composable)",
  "type": "object"
}
